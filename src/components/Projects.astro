---
const flagships = [
  {
    title: 'Weblit',
    type: 'SaaS · Next.js · TypeScript · Supabase · Claude AI · Stripe · Resend · Vercel',
    summary: "Managed website and web-app service for Australian small businesses, built, hosted and continuously improved for one monthly fee. One codebase runs the marketing site, client portal and admin dashboard, with tiered Stripe subscriptions.",
    hard: "An AI discovery flow (Claude API) that turns a short conversation with a business owner into a structured design brief, replacing the usual intake form.",
    url: 'https://weblit.com.au/',
    image: 'weblit',
    video: 'weblit',
  },
  {
    title: 'Reelbook',
    type: 'Client project · Next.js · TypeScript · Neon Postgres · Drizzle · Auth.js · Vercel',
    summary: "Private, cinematic gallery pages for YouTube and Vimeo videos, built for a paying client and live in production. Creators sign in to organise videos into chapters and share one link; viewers need no account.",
    hard: "Letting clients show their gallery on their own domain: the app connects it through the Vercel API and shows the DNS records still needed, with optional password protection for a whole book or a single page.",
    url: 'https://reelbook.com.au/',
    image: 'reelbook',
    video: 'reelbook',
  },
  {
    title: 'Seltra',
    type: 'SaaS · Next.js · TypeScript · Supabase · Claude AI · Resend · Vercel',
    summary: "Calm accounting for Australian solo operators and small businesses: CSV bank import, branded PDF invoices, and BAS (GST) and P&L reporting, without the cost or sprawl of Xero or MYOB.",
    hard: "AI suggests a category and GST treatment for every transaction with a confidence score, backed by a rules engine for recurring ones, while Postgres row-level security keeps each business's books separate.",
    url: 'https://seltra.com.au/',
    image: 'seltra',
    video: 'seltra',
  },
];

const more = [
  {
    title: 'JobWrap',
    type: 'SaaS · Next.js · Claude AI',
    summary: "Turns a technician's voice notes into a branded PDF service report.",
    proof: 'AI voice-to-report pipeline · free to try',
    url: 'https://jobwrap.app/',
    image: 'jobwrap',
  },
  {
    title: 'StayConnex',
    type: 'SaaS · React · Supabase',
    summary: 'Syncs Airbnb and Booking.com calendars and keeps cleaners updated in real time.',
    proof: 'In use by real hosts and cleaners',
    url: 'https://stayconnex.com/',
    image: 'stayconnex',
  },
  {
    title: 'Cosy Cowes Getaway',
    type: 'Booking site · Astro · Stripe',
    summary: 'Direct bookings for a Phillip Island holiday rental, synced with Airbnb.',
    proof: 'Takes real bookings · Airbnb Superhost, Guest Favourite',
    url: 'https://cosycowesgetaway.com/',
    image: 'cosy',
  },
  {
    title: 'Level Design',
    type: 'Marketing site · Astro · React',
    summary: 'Bespoke solid timber dining tables, designed and made to order in Melbourne.',
    proof: 'My own furniture business',
    url: 'https://leveldesign.com.au/',
    image: 'level',
  },
  {
    title: 'Andrea Flowers',
    type: 'Client project · Astro',
    summary: 'Multilingual website for a florist, designed and built end to end.',
    proof: 'Built for a client · live',
    url: 'https://kvetinarstvoandrea.com/',
    image: 'andrea',
  },
];

const shot = (name: string) => `/images/projects/shots/${name}`;
---

<section id="projects" class="py-20 lg:py-24">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight mb-16 reveal" style="color: var(--text);">Featured work</h2>

    {flagships.map((project, i) => {
      const imageOnLeft = i % 2 === 0;
      return (
        <article class="mb-24 lg:mb-28 reveal">
          <div class="project-grid items-center">
            <a href={project.url} target="_blank" rel="noopener noreferrer" class={`shot project-image block${imageOnLeft ? '' : ' md-order-2'}`} style="aspect-ratio: 1365/860;" aria-label={`Visit ${project.title}`}>
              <video
                class="project-video"
                muted
                loop
                playsinline
                preload="none"
                poster={`/videos/${project.video}-poster.webp`}
                width="1364"
                height="860"
                aria-hidden="true"
              >
                <source src={`/videos/${project.video}.webm`} type="video/webm" />
                <source src={`/videos/${project.video}.mp4`} type="video/mp4" />
              </video>
            </a>
            <div class={`project-text${imageOnLeft ? '' : ' md-order-1'}`}>
              <p class="text-xs uppercase letter-spacing-wide mb-3 font-medium leading-relaxed" style="color: var(--text-muted);">{project.type}</p>
              <h3 class="font-display text-3xl md:text-4xl font-bold tracking-tight mb-4" style="color: var(--text);">{project.title}</h3>
              <p class="leading-relaxed mb-6" style="color: var(--text-muted);">{project.summary}</p>
              <div class="border-l-2 pl-4 mb-6" style="border-color: var(--accent);">
                <p class="text-xs uppercase letter-spacing-wide font-medium mb-1" style="color: var(--accent);">The hard part</p>
                <p class="text-sm leading-relaxed" style="color: var(--text);">{project.hard}</p>
              </div>
              <a href={project.url} target="_blank" rel="noopener noreferrer" class="font-medium" style="color: var(--accent);" onmouseover="this.style.color='var(--hover-accent)'" onmouseout="this.style.color='var(--accent)'">
                View live →
              </a>
            </div>
          </div>
        </article>
      );
    })}

    <h2 class="font-display text-2xl md:text-3xl font-bold tracking-tight mb-10 reveal" style="color: var(--text);">More work</h2>
    <div class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {more.map((project) => (
        <article class="reveal">
          <a href={project.url} target="_blank" rel="noopener noreferrer" class="shot block mb-5" style="aspect-ratio: 1365/860;" aria-label={`Visit ${project.title}`}>
            <img
              src={`${shot(project.image)}.webp`}
              width="1365"
              height="860"
              alt={`${project.title} homepage`}
              loading="lazy"
              decoding="async"
            />
          </a>
          <p class="text-xs uppercase letter-spacing-wide mb-2 font-medium" style="color: var(--text-muted);">{project.type}</p>
          <h3 class="font-display text-xl font-bold tracking-tight mb-2" style="color: var(--text);">
            <a href={project.url} target="_blank" rel="noopener noreferrer" onmouseover="this.style.color='var(--hover-accent)'" onmouseout="this.style.color='var(--text)'">{project.title} <span aria-hidden="true" style="color: var(--accent);">↗</span></a>
          </h3>
          <p class="text-sm leading-relaxed mb-3" style="color: var(--text-muted);">{project.summary}</p>
          <p class="text-sm font-medium" style="color: var(--accent);">{project.proof}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .letter-spacing-wide {
    letter-spacing: 0.1em;
  }

  .project-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  /* On mobile: image always first */
  .project-image { order: 1; }
  .project-text  { order: 2; }

  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: 1.3fr 1fr;
      gap: 4rem;
    }
    /* Restore desktop order for alternating layout */
    .md-order-1 { order: 1; }
    .md-order-2 { order: 2; }
    .project-grid:has(.md-order-2) {
      grid-template-columns: 1fr 1.3fr;
    }
  }

  .shot img,
  .shot video {
    transition: transform 0.5s ease;
  }
  a.shot:hover img,
  a.shot:hover video {
    transform: scale(1.015);
  }

  .project-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
</style>

<script>
  // Play each product loop only while it's on screen; leave the poster for reduced motion
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const videos = document.querySelectorAll<HTMLVideoElement>('.project-video');

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting && !reduceMotion.matches) {
          if (video.preload !== 'auto') {
            video.preload = 'auto';
            video.load();
          }
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      }
    },
    { threshold: 0.35 }
  );

  videos.forEach((video) => observer.observe(video));
  reduceMotion.addEventListener('change', () => {
    if (reduceMotion.matches) videos.forEach((video) => video.pause());
  });
</script>
